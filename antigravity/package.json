{
  "name": "cataly-antigravity",
  "version": "1.0.0",
  "description": "Cataly autonomous AI teammate ported natively to Google Antigravity (Plugin + MCP Server + Hooks + Subagents + Discord).",
  "type": "module",
  "bin": {
    "cataly": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "install:plugin": "npm run build && node scripts/install-plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
