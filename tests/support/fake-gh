#!/bin/sh
# A fake `gh` for tests. It answers from JSON files in the `gh-data` directory next to it and
# appends each call to `gh-data/calls.log`. It never contacts GitHub.
#   gh pr list ...        -> gh-data/pr-list.json
#   gh api [-H h] PATH    -> gh-data/<PATH without query, leading / dropped, / as _>.json
#                            later pages use <PATH>.page-N.json, or [] when absent
#                            a missing first-page fixture answers HTTP 404
#   <response file>.delay -> sleep this many seconds before returning the response
#   gh repo create O/N --private -> writes repos_O_N.json as a private repository
dir=$(cd "$(dirname "$0")" && pwd)/gh-data
printf '%s\n' "$*" >> "$dir/calls.log"
case "$1" in
pr)
    file="$dir/pr-list.json"
    ;;
repo)
    [ "$2" = create ] || { echo "fake gh: unsupported repo command $2" >&2; exit 2; }
    owner=${3%%/*}
    name=${3#*/}
    case "$*" in *--private*) private=true ;; *) private=false ;; esac
    printf '{"name":"%s","private":%s}\n' "$name" "$private" > "$dir/repos_${owner}_${name}.json"
    echo "https://github.com/$3"
    exit 0
    ;;
api)
    for last in "$@"; do :; done
    case "$last" in
    *"&page="*) page=${last#*&page=} ;;
    *"?page="*) page=${last#*\?page=} ;;
    *) page=1 ;;
    esac
    page=${page%%&*}
    path=${last%%\?*}
    path=${path#/}
    file="$dir/$(printf '%s' "$path" | tr '/' '_').json"
    if [ "$page" != 1 ]; then
        file="${file%.json}.page-$page.json"
        [ -f "$file" ] || { echo '[]'; exit 0; }
    fi
    ;;
*)
    echo "fake gh: unsupported command $1" >&2
    exit 2
    ;;
esac
if [ -f "$file" ]; then
    if [ -f "$file.delay" ]; then
        sleep "$(cat "$file.delay")"
    fi
    cat "$file"
else
    case "$1" in
    api) echo "gh: Not Found (HTTP 404)" >&2 ;;
    *) echo "fake gh: no fixture $(basename "$file")" >&2 ;;
    esac
    exit 1
fi
