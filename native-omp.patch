+			await registry.executeOnSession("join current", "/tmp", { ...current, kernelOwnerId: "remaining" });
+			await registry.executeOnSession("shared", "/tmp", shared);
+			await registry.executeOnSession("join shared", "/tmp", { ...shared, kernelOwnerId: "remaining" });
+			await registry.executeOnSession("stale", "/tmp", stale);
+			await registry.executeOnSession("foreign", "/tmp", foreign);
+			const kept = registry.peekLiveKernel("/tmp", current)!;
+			const sharedKernel = registry.peekLiveKernel("/tmp", shared)!;
+			const staleKernel = registry.peekLiveKernel("/tmp", stale)!;
+			const foreignKernel = registry.peekLiveKernel("/tmp", foreign)!;
