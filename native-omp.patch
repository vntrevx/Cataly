+async function executeJsCell(session: AgentSession, code: string): Promise<string> {
+	const tool = session.getToolByName("eval");
+	if (!tool) throw new Error("Expected the session's eval tool");
+	const result = await tool.execute(
+		Snowflake.next(),
+		{ language: "js", code, timeout: 0 },
+		undefined,
+		undefined,
+		undefined,
+	);
