+/** Hold a real isolated worker's init until the test releases the retained startup record. */
+function createInitGatedWorker(): {
+	handle: JsEvalWorkerHandle;
+	initialized: Promise<void>;
+	release(): void;
+	stop(): Promise<void>;
+} {
+	const worker = new Worker(new URL("../../src/eval/js/worker-entry.ts", import.meta.url).href, { type: "module" });
+	const initialized = Promise.withResolvers<void>();
+	const exited = Promise.withResolvers<void>();
+	const listeners = new Set<(message: WorkerOutbound) => void>();
+	let heldInit: Extract<WorkerInbound, { type: "init" }> | undefined;
+	let released = false;
+	let stopped = false;
+	worker.addEventListener("message", (event: MessageEvent<WorkerOutbound>) => {
+		for (const listener of listeners) listener(event.data);
+	});
+	worker.addEventListener("close", () => exited.resolve());
+	const stop = async (): Promise<void> => {
+		if (!stopped) {
+			stopped = true;
+			worker.terminate();
+		}
+		await exited.promise;
+	};
+	return {
+		initialized: initialized.promise,
+		release() {
+			released = true;
+			if (!heldInit) return;
+			worker.postMessage(heldInit);
+			heldInit = undefined;
+		},
+		stop,
+		handle: {
+			mode: "worker",
+			send(message) {
+				if (message.type === "init" && !released) {
+					heldInit = message;
+					initialized.resolve();
+					return;
+				}
+				worker.postMessage(message);
+			},
+			onMessage(handler) {
+				listeners.add(handler);
+				return () => listeners.delete(handler);
+			},
+			onError(handler) {
+				const onError = (event: ErrorEvent): void =>
+					handler(event.error instanceof Error ? event.error : new Error(event.message));
+				worker.addEventListener("error", onError);
+				return () => worker.removeEventListener("error", onError);
+			},
+			async close() {
+				await stop();
+				return true;
+			},
+			terminate: stop,
+		},
+	};
+}
+
+async function executeLifetimeCell(sessionKey: string, ownerId: string, code: string): Promise<string> {
+	const chunks: string[] = [];
+	await executeInVmContext({
+		sessionKey,
+		sessionId: sessionKey,
+		ownerId,
+		cwd: process.cwd(),
+		session: {
+			...createSession(),
+			getEvalSessionId: () => sessionKey,
+			getEvalKernelOwnerId: () => ownerId,
+		},
+		code,
+		filename: "[owner-lifetime].js",
+		runState: { onText: chunk => chunks.push(chunk) },
+	});
+	return chunks.join("").trim();
+}
