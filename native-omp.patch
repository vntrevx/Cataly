+			await registry.disposeByOwner("departing", { keepSessionId: current.sessionId });
+			expect(registry.peekLiveKernel("/tmp", current)).toBe(kept);
+			expect(registry.peekLiveKernel("/tmp", shared)).toBe(sharedKernel);
+			expect(registry.peekLiveKernel("/tmp", stale)).toBeUndefined();
+			expect(staleKernel.alive).toBe(false);
+			expect(registry.peekLiveKernel("/tmp", foreign)).toBe(foreignKernel);
